{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "narrative",
    "fixture_id",
    "runtime",
    "runtime_version",
    "selected",
    "stage",
    "gate",
    "review_conclusion",
    "packet_readiness",
    "packet_ref",
    "packet_version",
    "packet_digest",
    "access_confirmation",
    "recommendation",
    "human_decision",
    "decision_evidence_status",
    "evidence_recorded_at",
    "wait_reason",
    "blocked_reason",
    "planned_writes",
    "evidence_fields",
    "limitations"
  ],
  "properties": {
    "narrative": {"type": "string"},
    "fixture_id": {"type": "string"},
    "runtime": {"enum": ["codex", "claude"]},
    "runtime_version": {"type": "string", "minLength": 1},
    "selected": {"type": "boolean"},
    "stage": {
      "enum": [
        "intake", "routed", "researching", "designing", "reviewing",
        "waiting_human", "approved_design_only", "approved_for_spec",
        "publishing", "handed_off", "completed_design_only", "rejected",
        "not_applicable"
      ]
    },
    "gate": {
      "enum": [
        "none", "BLOCKED", "NEEDS_REVISION", "APPROVABLE_WITH_WARNINGS",
        "APPROVABLE", "approved_design_only", "approved_for_spec",
        "revision_requested", "rejected", "not_applicable"
      ]
    },
    "review_conclusion": {
      "enum": [
        "none", "BLOCKED", "NEEDS_REVISION",
        "APPROVABLE_WITH_WARNINGS", "APPROVABLE"
      ]
    },
    "packet_readiness": {
      "enum": ["none", "review_packet_ready", "review_packet_unavailable"]
    },
    "packet_ref": {"type": "string", "minLength": 1},
    "packet_version": {
      "type": "string",
      "pattern": "^(none|v[1-9][0-9]*)$"
    },
    "packet_digest": {
      "type": "string",
      "pattern": "^(none|sha256:[0-9a-f]{64})$"
    },
    "access_confirmation": {
      "enum": ["none", "confirmed", "unconfirmed", "not_applicable"]
    },
    "recommendation": {
      "enum": [
        "none", "recommend_approved_for_spec",
        "recommend_approved_design_only", "recommend_revision",
        "no_recommendation"
      ]
    },
    "human_decision": {
      "enum": [
        "none", "approved_design_only", "approved_for_spec",
        "revision_requested", "rejected"
      ]
    },
    "decision_evidence_status": {
      "enum": ["none", "valid", "invalid", "noop"]
    },
    "evidence_recorded_at": {
      "type": "string",
      "pattern": "^(none|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)$"
    },
    "wait_reason": {"enum": ["none", "design_approval", "target_project"]},
    "blocked_reason": {
      "enum": [
        "none", "missing_subject_project", "missing_target_project",
        "missing_openspec_explore", "missing_brainstorming",
        "critical_evidence_gaps", "review_packet_unavailable",
        "approved_artifact_unavailable"
      ]
    },
    "planned_writes": {
      "type": "array",
      "items": {
        "enum": [
          "issue:ARCH-CONTROL", "issue:ARCH-RESEARCH", "issue:ARCH-DESIGN",
          "issue:ARCH-REVIEW", "issue:ARCH-APPROVAL-PACKET", "issue:ARCH-RD-HANDOFF",
          "architecture-repo:ADR", "architecture-repo:detailed-design"
        ]
      }
    },
    "evidence_fields": {
      "type": "array",
      "items": {
        "enum": [
          "issue", "subject_project", "design_type", "stage", "next_action",
          "design_version", "review_version", "approval_evidence",
          "target_project", "findings", "owner", "closure_condition",
          "runtime", "blocked_reason", "routing_reason", "review_conclusion",
          "packet_ref", "packet_version", "packet_digest", "packet_readiness",
          "access_confirmation", "recommendation", "human_decision",
          "decision_evidence", "evidence_recorded_at"
        ]
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
